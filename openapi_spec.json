{
  "openapi": "3.1.0",
  "info": {
    "title": "Fermentation Gas Mass Spectrometry API",
    "description": "Local legacy audit workflows and validated dry off-gas molar balance calculations.",
    "version": "2.1.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "API health and version JSON"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory audit counters",
        "responses": {
          "200": {
            "description": "JSON counters (not Prometheus text)"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock supervisor response",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read and verify in-memory HMAC audit chain",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/offgas/calculate": {
      "post": {
        "summary": "Calculate OUR, CER and RQ using a dry-gas inert balance",
        "description": "Gas flow in mmol/min; mole fractions dimensionless 0–1. RQ is null when oxygen uptake is not positive.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "inlet_flow_mmol_min",
                  "inlet_o2",
                  "inlet_co2",
                  "outlet_o2",
                  "outlet_co2"
                ],
                "properties": {
                  "inlet_flow_mmol_min": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "inlet_o2": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "inlet_co2": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "outlet_o2": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "outlet_co2": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rates and RQ on valid input; RQ may be null"
          },
          "422": {
            "description": "Invalid gas balance measurements"
          }
        }
      }
    }
  }
}
